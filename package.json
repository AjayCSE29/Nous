{
  "name": "nous",
  "version": "0.1.0",
  "description": "A private Fedora desktop client for local Ollama models",
  "main": "src/main/index.cjs",
  "productName": "Nous",
  "license": "MIT",
  "author": "Ajay",
  "homepage": "https://github.com/AjayCSE29/Nous",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node --test tests/unit/*.cjs tests/integration/*.cjs tests/renderer/*.cjs",
    "vendor": "node scripts/vendor-renderer-deps.cjs",
    "build": "electron-builder --linux",
    "rpm": "bash scripts/package-rpm.sh",
    "dist": "npm run vendor && npm run build && npm run rpm"
  },
  "devDependencies": {
    "dompurify": "^3.4.15",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.0",
    "katex": "^0.18.7",
    "marked": "^18.0.11"
  }
}
